<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:background="@drawable/bg_overlay_bubble"
    android:contentDescription="@string/overlay_bubble_description"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/bubbleValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/value_placeholder"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bubbleTemperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/value_placeholder"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
