<?xml version="1.0" encoding="utf-8"?>
<!--
    监控数据仅在设备本地使用，不参与云备份与设备迁移。
    M0 起 allowBackup=false；此规则用于满足 Android 12+ 的显式声明要求。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
